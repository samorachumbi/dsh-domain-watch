{
  "name": "dsh-domain-watch",
  "version": "0.2.0",
  "description": "A presence pill in the harness shell plus four agent tools: whether a domain is really registered at the REGISTRY, who the registrar of record is, when it dies, and whether the dashboard telling you it is fine is telling the truth.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "domains",
    "whois",
    "registry",
    "expiry",
    "portfolio"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samorachumbi/dsh-domain-watch.git"
  },
  "homepage": "https://github.com/samorachumbi/dsh-domain-watch#readme",
  "author": "Samora Chumbi",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "clean": "rm -rf lib",
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.ts",
    "probe": "node scripts/probe.mjs",
    "client": "node scripts/build-client.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-json": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "22.20.0",
    "typescript": "6.0.3"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
